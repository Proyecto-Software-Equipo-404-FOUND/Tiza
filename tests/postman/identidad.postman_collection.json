              ]
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "MODIFICA DATOS O SESIONES. Requiere autorización y entorno desechable. ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\",\n  \"nombre\": \"{{newUserName}}\",\n  \"apellido\": \"{{newUserSurname}}\",\n  \"rol\": \"{{newUserRole}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
