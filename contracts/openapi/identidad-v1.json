    "/api/auth/invitado": {
      "post": {
        "tags": [
          "Auth"
        ],
        "x-estado": "planificado",
        "summary": "Ingreso de un alumno invitado (sin cuenta) con PIN + nombre.",
        "description": "Proveedor: S3-SA-01 (#231, Ariel; revisa Rubén). Consumidor: Frontend S3-FE-04 (#235, Melany). Identidad consulta a Sala en vivo GET /interno/salas/pin/{pin} y, si la sala admite invitados y no está finalizada, emite un JWT de rol Invitado con sala_id. Público (sin token). Los errores de negocio llevan su código en `type` (por ejemplo `SALA_SIN_INVITADOS`), para que el front muestre el mensaje correcto.",
        "operationId": "IngresoInvitado",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngresoInvitadoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión de invitado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionInvitado"
                }
              }
            }
          },
          "400": {
            "description": "Nombre vacío o demasiado largo.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "El nombre tiene que tener entre 2 y 60 caracteres.",
                  "status": 400,
                  "type": "NOMBRE_INVALIDO"
                }
              }
            }
          },
          "403": {
            "description": "La sala no admite invitados.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Esta sala no admite invitados. Pedile al docente que te habilite.",
                  "status": 403,
                  "type": "SALA_SIN_INVITADOS"
                }
              }
            }
          },
          "404": {
            "description": "No hay una sala activa con ese PIN.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Sala no encontrada.",
                  "status": 404,
                  "type": "SALA_NO_ENCONTRADA"
                }
              }
            }
          },
          "409": {
            "description": "La sala ya finalizó.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "La sala ya finalizó.",
                  "status": 409,
                  "type": "SALA_FINALIZADA"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/DemasiadosIntentos"
          },
          "503": {
            "description": "Identidad no pudo consultar a Sala en vivo para verificar el PIN. Se puede reintentar.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No pudimos verificar la sala. Probá de nuevo en unos segundos.",
                  "status": 503,
                  "type": "SALA_NO_DISPONIBLE"
                }
              }
            }
          }
        }
      }
    },
    "/api/usuarios/{id}/baja": {
      "post": {
        "tags": [
          "Usuarios"
        ],
        "summary": "[S3-ID-01, #243] Da de baja a un alumno o docente de la institución.",
        "description": "Solo Administrador de la misma institución. Pone Activo = false y revoca sus refresh tokens en una transacción: no puede iniciar sesión ni renovar, y su JWT vigente deja de servir en Identidad. No borra datos (fuera de alcance: borrado definitivo). Un usuario Administrador → 403; inexistente o de otra institución → 404.",
        "operationId": "DarBajaUsuario",
        "responses": {
          "204": {
            "description": "Listo (también si ya estaba en ese estado: es idempotente)."
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/SinPermiso"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/usuarios/{id}/reactivar": {
      "post": {
        "tags": [
          "Usuarios"
        ],
        "summary": "[S3-ID-01, #243] Reactiva a un alumno o docente dado de baja.",
        "description": "Solo Administrador de la misma institución. Pone Activo = true: puede volver a iniciar sesión, pero no recupera sesiones anteriores (los refresh tokens siguen revocados). Un usuario Administrador → 403; inexistente o de otra institución → 404.",
        "operationId": "ReactivarUsuario",
        "responses": {
          "204": {
            "description": "Listo (también si ya estaba en ese estado: es idempotente)."
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/SinPermiso"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT institucional emitido por /api/auth/login (ver JwtInstitucional)."
      },
      "PlatformBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT de plataforma (identity_type=platform, role=AdministradorGlobal)."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 150
          },
          "password": {
            "type": "string",
            "description": "Máximo 72 bytes en UTF-8."
          }
        },
        "example": {
          "email": "docente@a.test",
          "password": "********"
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "accessTokenExpiresAt",
          "refreshTokenExpiresAt"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT institucional. Ver JwtInstitucional."
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "nombre",
          "apellido",
          "rol"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 150
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Contraseña. Máximo 72 bytes en UTF-8 (límite de BCrypt)."
          },
          "nombre": {
            "type": "string",
            "maxLength": 100
          },
          "apellido": {
            "type": "string",
            "maxLength": 100
          },
          "rol": {
            "type": "string",
            "enum": [
              "Docente",
              "Alumno"
            ]
          }
        }
      },
      "UsuarioRegistrado": {
        "type": "object",
        "required": [
          "id",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Mensaje": {
        "type": "object",
        "properties": {
          "mensaje": {
            "type": "string"
          }
        }
      },
      "UsuarioResumen": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "apellido",
          "email",
          "rol"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Mismo valor que el claim sub. Es el AlumnoId/DocenteId que usan Cursos, Sala y Evaluaciones."
          },
          "nombre": {
            "type": "string"
          },
          "apellido": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "rol": {
            "type": "string",
            "enum": [
              "Administrador",
              "Docente",
              "Alumno"
            ]
          }
        }
      },
      "ResultadoImportacion": {
        "type": "object",
        "required": [
          "creados",
          "omitidos",
          "errores"
        ],
        "properties": {
          "creados": {
            "type": "integer",
            "minimum": 0
          },
          "omitidos": {
            "type": "integer",
            "minimum": 0,
            "description": "Filas con un email que ya existía."
          },
          "errores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fila",
                "motivo"
              ],
              "properties": {
                "fila": {
                  "type": "integer",
                  "minimum": 1
                },
                "motivo": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "TokenPlataforma": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          }
        }
      },
      "CrearInstitucionRequest": {
        "type": "object",
        "required": [
          "nombre",
          "codigo",
          "emailAdministrador",
          "nombreAdministrador",
          "apellidoAdministrador"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 150
          },
          "codigo": {
            "type": "string",
            "maxLength": 30
          },
          "emailAdministrador": {
            "type": "string",
            "format": "email",
            "maxLength": 150
          },
          "nombreAdministrador": {
            "type": "string",
            "maxLength": 100
          },
          "apellidoAdministrador": {
            "type": "string",
            "maxLength": 100
          }
        }
      },
      "InstitucionCreada": {
        "type": "object",
        "required": [
          "institucionId",
          "administradorId"
        ],
        "properties": {
          "institucionId": {
            "type": "string",
            "format": "uuid"
          },
          "administradorId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "InstitucionResumen": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "codigo",
          "activo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "codigo": {
            "type": "string"
          },
          "activo": {
            "type": "boolean"
          }
        }
      },
      "ActivarAdministradorRequest": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Contraseña. Máximo 72 bytes en UTF-8 (límite de BCrypt)."
          }
        }
      },
      "JwtInstitucional": {
        "type": "object",
        "description": "Claims del access token institucional (HS256, 15 minutos). Es el contrato que leen TODOS los servicios: configurar MapInboundClaims=false, NameClaimType=sub y RoleClaimType=role. Issuer PEI.Identidad, Audience PEI. S3-SA-01 (#231): el rol Invitado no trae email y sí sala_id y name; sub es un id nuevo por ingreso. Ningún servicio fuera de Sala en vivo debe aceptar ese rol.",
        "required": [
          "sub",
          "institucion_id",
          "role",
          "email",
          "jti",
          "iat",
          "exp",
          "iss",
          "aud"
        ],
        "properties": {
          "sub": {
            "type": "string",
            "format": "uuid",
            "description": "Id del usuario."
          },
          "institucion_id": {
            "type": "string",
            "format": "uuid",
            "description": "Institución (tenant). Todos los servicios filtran por este valor."
          },
          "role": {
            "type": "string",
            "enum": [
              "Administrador",
              "Docente",
              "Alumno",
              "Invitado"
            ]
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "jti": {
            "type": "string"
          },
          "iat": {
            "type": "integer"
          },
          "exp": {
            "type": "integer"
          },
          "iss": {
            "type": "string",
            "enum": [
              "PEI.Identidad"
            ]
          },
          "aud": {
            "type": "string",
            "enum": [
              "PEI"
            ]
          },
          "sala_id": {
            "type": "string",
            "format": "uuid",
            "description": "Solo en tokens de rol Invitado (S3-SA-01, #231): la única sala donde vale el token."
          },
          "name": {
            "type": "string",
            "description": "Solo en tokens de rol Invitado: el nombre que escribió."
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Solo en 400 de validación (ValidationProblemDetails)."
          }
        }
      },
      "IngresoInvitadoRequest": {
        "type": "object",
        "required": [
          "pin",
          "nombre"
        ],
        "properties": {
          "pin": {
            "type": "integer",
            "minimum": 100000,
            "maximum": 999999
          },
          "nombre": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "description": "Nombre y apellido que va a ver el docente."
          }
        },
        "example": {
          "pin": 482913,
          "nombre": "Lucía Fernández"
        }
      },
      "SesionInvitado": {
        "type": "object",
        "required": [
          "accessToken",
          "expiraEnUtc",
          "salaId",
          "nombre"
        ],
        "description": "Token de rol Invitado, válido solo para la sala del PIN. No tiene refresh token.",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiraEnUtc": {
            "type": "string",
            "format": "date-time",
            "description": "4 horas desde la emisión del token (el ingreso). No tiene refresh: ante un 401, el front vuelve a la pantalla de ingreso de invitado y el alumno entra de nuevo con PIN + nombre."
          },
          "salaId": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "PeticionInvalida": {
        "description": "Datos inválidos (ProblemDetails o ValidationProblemDetails con errors).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "NoAutenticado": {
        "description": "Credenciales o token inválidos, vencidos o ausentes.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "SinPermiso": {
        "description": "El token es válido pero el rol no tiene permiso.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "NoEncontrado": {
        "description": "No existe, es de otra institución, o la función de plataforma está deshabilitada.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Conflicto": {
        "description": "Ya existe (email o código repetido).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "TipoNoSoportado": {
        "description": "Content-Type distinto de application/json.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "DemasiadosIntentos": {
        "description": "Se superó el límite de intentos (rate limit login).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "ErrorInterno": {
        "description": "Error inesperado del servidor.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  }
}
