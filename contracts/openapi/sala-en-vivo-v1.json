{
  "openapi": "3.0.1",
  "info": {
    "title": "PEI Sala en Vivo API (HTTP)",
    "version": "v1",
    "description": "Contrato HTTP de Sala en vivo (S2-CT-01, #165). Lo que pasa durante el examen (ingresar con PIN, iniciar, avanzar, responder, finalizar) va por SignalR y está en contracts/signalr/sala-hub-v1.md. Al finalizar, Sala envía las entregas a Evaluaciones según contracts/schemas/lote-entregas-v1.schema.json. Consumidor de este contrato: Frontend (panel del docente, S2-FE-01 #141)."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Gateway YARP"
    }
  ],
  "tags": [
    {
      "name": "Salas"
    }
  ],
  "paths": {
    "/api/v1/salas": {
      "post": {
        "tags": [
          "Salas"
        ],
        "summary": "Abre una sala en vivo para una evaluación publicada y genera su PIN.",
        "description": "Solo Docente o Administrador. La institución se toma del claim institucion_id del token, NUNCA del cuerpo. La evaluación tiene que existir, estar Publicada y ser de la misma institución (se consulta a Evaluaciones). Genera un PIN de 6 dígitos único entre las salas activas. La sala vence duracionMinutos después de creada (por defecto 120; FechaVencimiento). Estado inicial: Activa (esperando alumnos); pasa a EnCurso con IniciarSala y a Finalizada con FinalizarSala por el hub.",
        "operationId": "CrearSala",
        "security": [
          {
            "Bearer": []
          }
        ],
        "x-brechas": [
          "El código actual recibe institucionId en el cuerpo y no exige token: corregir en S2-ID-01 (#134).",
          "El código actual no valida que la evaluación esté publicada ni que sea de la institución: corregir en S2-SA-03 (#140)."
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearSalaRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sala creada. Header Location: /api/v1/salas/{id}.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalaCreada"
                }
              }
            }
          },
          "400": {
            "description": "capacidadMaxima fuera de rango o datos inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "La capacidad máxima debe estar entre 1 y 100.",
                  "status": 400
                }
              }
            }
          },
          "401": {
            "description": "Falta el token o es inválido.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No autenticado.",
                  "status": 401
                }
              }
            }
          },
          "403": {
            "description": "El rol no puede abrir salas (Alumno).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Solo un docente o administrador puede abrir una sala.",
                  "status": 403
                }
              }
            }
          },
          "404": {
            "description": "La evaluación no existe, no está publicada o es de otra institución.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No existe una evaluación publicada con ese id.",
                  "status": 404
                }
              }
            }
          },
          "503": {
            "description": "No se pudo generar un PIN libre o Evaluaciones no respondió.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No se pudo abrir la sala, intentá de nuevo.",
                  "status": 503
                }
              }
            }
          }
        }
      }
    },
    "/interno/salas/pin/{pin}": {
      "get": {
        "tags": [
          "Salas"
        ],
        "x-estado": "planificado",
        "summary": "[Interno] Datos de una sala por PIN, para emitir el token de invitado.",
        "description": "Proveedor: S3-SA-01 (#231, Ariel). Consumidor: Identidad, POST /api/auth/invitado. Endpoint interno: no se publica en el gateway.",
        "operationId": "ObtenerSalaParaInvitado",
        "security": [
          {
            "ApiKeyInterna": []
          }
        ],
        "parameters": [
          {
            "name": "pin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 100000,
              "maximum": 999999
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datos de la sala.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalaParaInvitado"
                }
              }
            }
          },
          "401": {
            "description": "Falta la clave interna o es incorrecta.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No autenticado.",
                  "status": 401
                }
              }
            }
          },
          "404": {
            "description": "No hay una sala activa con ese PIN.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Sala no encontrada.",
                  "status": 404,
                  "type": "SALA_NO_ENCONTRADA"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT institucional de Identidad (ver identidad-v1.json, JwtInstitucional)."
      },
      "ApiKeyInterna": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key-Interna",
        "description": "Misma clave compartida entre servicios que usa Evaluaciones (ServiciosInternos:ApiKey). Los endpoints /interno/... no se publican en el gateway."
      }
    },
    "schemas": {
      "CrearSalaRequest": {
        "type": "object",
        "required": [
          "evaluacionId"
        ],
        "properties": {
          "evaluacionId": {
            "type": "string",
            "format": "uuid",
            "description": "Evaluación Publicada que se va a tomar."
          },
          "capacidadMaxima": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 40,
            "description": "Cupo de alumnos. Máximo 100 (meta de rendimiento del proyecto)."
          },
          "duracionMinutos": {
            "type": "integer",
            "minimum": 5,
            "maximum": 240,
            "default": 120,
            "description": "Minutos que dura el examen. Desde S3-SA-02 (#239) se cuentan desde que el docente inicia la sala (IniciarSala), no desde que se crea."
          },
          "permitirInvitados": {
            "type": "boolean",
            "default": false,
            "description": "S3-SA-01 (#231). Si es true, se puede entrar con PIN + nombre sin cuenta (rol Invitado). Por defecto, no."
          }
        },
        "example": {
          "evaluacionId": "3c4d5e6f-7a8b-4c9d-8e0f-1a2b3c4d5e6f",
          "capacidadMaxima": 30,
          "duracionMinutos": 45,
          "permitirInvitados": false
        }
      },
      "SalaCreada": {
        "type": "object",
        "required": [
          "id",
          "codigoPIN",
          "fechaVencimiento",
          "capacidadMaxima"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Se usa en UnirseASalaDocente(salaId)."
          },
          "codigoPIN": {
            "type": "integer",
            "minimum": 100000,
            "maximum": 999999,
            "description": "PIN de 6 dígitos que el docente proyecta y el alumno usa en UnirseASala(pin)."
          },
          "fechaVencimiento": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "S3-SA-02 (#239): null hasta que el docente inicia la sala. Al iniciar se calcula con duracionMinutos y llega a todos por el evento salaIniciada (ver signalr/sala-hub-v1.md)."
          },
          "capacidadMaxima": {
            "type": "integer"
          },
          "permitirInvitados": {
            "type": "boolean",
            "description": "S3-SA-01 (#231)."
          },
          "duracionMinutos": {
            "type": "integer",
            "description": "S3-SA-02 (#239)."
          }
        },
        "example": {
          "id": "6a2b7c3d-8e9f-4a01-b2c3-d4e5f6a7b8c9",
          "codigoPIN": 482913,
          "fechaVencimiento": null,
          "duracionMinutos": 45,
          "capacidadMaxima": 30,
          "permitirInvitados": false
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "SalaParaInvitado": {
        "type": "object",
        "required": [
          "salaId",
          "institucionId",
          "permiteInvitados",
          "estado"
        ],
        "description": "S3-SA-01 (#231). Lo que Identidad necesita para emitir el token de invitado.",
        "properties": {
          "salaId": {
            "type": "string",
            "format": "uuid"
          },
          "institucionId": {
            "type": "string",
            "format": "uuid"
          },
          "permiteInvitados": {
            "type": "boolean"
          },
          "estado": {
            "type": "string",
            "enum": [
              "Abierta",
              "Iniciada",
              "Finalizada"
            ]
          }
        },
        "example": {
          "salaId": "6a2b7c3d-8e9f-4a01-b2c3-d4e5f6a7b8c9",
          "institucionId": "11111111-1111-1111-1111-111111111111",
          "permiteInvitados": true,
          "estado": "Abierta"
        }
      }
    }
  }
}
