    "/api/v1/cursos/{cursoId}/materiales": {
      "post": {
        "tags": [
          "Materiales"
        ],
        "summary": "Sube un apunte PDF al curso y extrae su texto.",
        "description": "El archivo se guarda en el almacenamiento de archivos (en local, una carpeta; en la nube, Supabase Storage o R2), nunca en PostgreSQL. El texto se extrae con PdfPig y se guarda junto a la ficha. Validaciones en orden: es PDF (415), tamaño hasta 10 MB (400, RN-MAT-03), hasta 30 páginas (400, RN-MAT-03), tiene texto seleccionable (400, RN-MAT-04). Permisos (RN-MAT-01/02): Administrador de la institución, o Docente asignado a alguna cohorte activa del curso. Alumno → 403.",
        "operationId": "SubirMaterial",
        "parameters": [
          {
            "name": "cursoId",
            "in": "path",
            "required": true,
            "description": "UUID del curso.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "archivo"
                ],
                "properties": {
                  "archivo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Archivo PDF, máximo 10 MB y 30 páginas."
                  },
                  "titulo": {
                    "type": "string",
                    "maxLength": 150,
                    "description": "Título visible. Si no se envía, se usa el nombre del archivo sin extensión."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Material subido y procesado. Header Location: /api/v1/cursos/{cursoId}/materiales/{id}.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaterialCursoDto"
                }
              }
            }
          },
          "400": {
            "description": "Supera 10 MB o 30 páginas, o el PDF no tiene texto seleccionable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "El PDF no tiene texto seleccionable. Subí un PDF generado desde un procesador de texto, no escaneado.",
                  "status": 400
                }
              }
            }
          },
          "401": {
            "description": "No autenticado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No autenticado.",
                  "status": 401
                }
              }
            }
          },
          "403": {
            "description": "El rol no tiene permiso (Alumno, o Docente que no da clases en el curso).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No tenés permiso para gestionar el material de este curso.",
                  "status": 403
                }
              }
            }
          },
          "404": {
            "description": "El curso no existe, está dado de baja o es de otra institución.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Curso no encontrado.",
                  "status": 404
                }
              }
            }
          },
          "415": {
            "description": "El archivo no es un PDF.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Solo se aceptan archivos PDF.",
                  "status": 415
                }
              }
            }
          }
        },
        "x-estado": "planificado",
        "x-issue": "S2-CU-01 (#137)"
      },
