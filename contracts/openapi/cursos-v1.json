    "/api/v1/cohortes/{cohorteId}/matriculas": {
      "get": {
        "tags": [
          "Matriculaciones"
        ],
        "summary": "Obtiene el listado de matriculaciones de una cohorte (S2-CU-01).",
        "description": "Retorna la lista inmutable de matriculaciones de la cohorte especificada, admitiendo filtrado opcional por matriculaciones activas para consumo de Sala en Vivo.",
        "operationId": "GetMatriculaciones",
        "parameters": [
          {
            "name": "cohorteId",
            "in": "path",
            "description": "UUID de la cohorte a consultar.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "soloActivas",
            "in": "query",
            "description": "Filtro opcional para obtener solo matriculaciones activas (por defecto true).",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de matriculaciones obtenido exitosamente (o arreglo vacío si no posee inscriptos).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatriculacionDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Identificador de cohorte inválido.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Cohorte inexistente, inactiva o perteneciente a otra institución.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Matriculaciones"
        ],
        "summary": "Matricula formalmente a un alumno en una comisión (CU-04).",
        "operationId": "MatricularAlumno",
        "parameters": [
          {
            "name": "cohorteId",
            "in": "path",
            "description": "UUID de la cohorte de destino.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Identificador del alumno a matricular.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatricularAlumnoDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Alumno matriculado exitosamente.",
            "headers": {
              "Location": {
                "description": "URL del recurso matrícula generado.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatriculacionDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o cohorte inactiva.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Cohorte inexistente en el inquilino.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto: El alumno ya se encuentra matriculado en esta cohorte.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
