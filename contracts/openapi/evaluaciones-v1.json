{
  "openapi": "3.0.1",
  "info": {
    "title": "PEI Tiza — Servicio de Evaluaciones",
    "description": "Creación, edición, publicación y consulta de evaluaciones de cada institución. Una evaluación nace en estado Borrador (se puede editar y borrar) y pasa a Publicada al publicarse con una cohorte asociada. Todos los endpoints exigen el header X-Institucion-Id, que es una solución temporal hasta que Identidad emita el JWT y la institución se lea del token.",
    "contact": {
      "name": "Equipo 404 Found",
      "email": "equipo404found@tiza.pei.edu.ar"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Gateway YARP (recomendado para el frontend)"
    },
    {
      "url": "http://localhost:5103",
      "description": "Servicio directo (desarrollo local)"
    }
  ],
  "tags": [
    {
      "name": "Evaluaciones",
      "description": "CRUD y publicación de evaluaciones."
    },
    {
      "name": "Interno",
      "description": "Endpoints entre servicios. No se exponen por el gateway."
    },
    {
      "name": "Resultados",
      "description": "Consulta de entregas y resultados para el docente (S2-EV-03)."
    }
  ],
  "paths": {
    "/api/v1/evaluaciones": {
      "get": {
        "tags": [
          "Evaluaciones"
        ],
        "summary": "Lista las evaluaciones de la institución.",
        "operationId": "ListarEvaluaciones",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstitucionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de evaluaciones de la institución (puede estar vacía).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Evaluacion"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PeticionInvalida"
          }
        }
      },
      "post": {
        "tags": [
          "Evaluaciones"
        ],
        "summary": "Crea una evaluación en estado Borrador.",
        "operationId": "CrearEvaluacion",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstitucionId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluacionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Evaluación creada. El header Location apunta a GET /api/v1/evaluaciones/{id}.",
            "headers": {
              "Location": {
                "description": "URL de la evaluación creada.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluacion"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PeticionInvalida"
          }
        }
      }
    },
    "/api/v1/evaluaciones/{id}": {
      "get": {
        "tags": [
          "Evaluaciones"
        ],
        "summary": "Obtiene una evaluación de la institución.",
        "operationId": "ObtenerEvaluacion",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstitucionId"
          },
          {
            "$ref": "#/components/parameters/EvaluacionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluación encontrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluacion"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PeticionInvalida"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrada"
          }
        }
      },
      "put": {
        "tags": [
          "Evaluaciones"
        ],
        "summary": "Modifica título, tipo y preguntas de una evaluación en Borrador.",
        "operationId": "ActualizarEvaluacion",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstitucionId"
          },
          {
            "$ref": "#/components/parameters/EvaluacionId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluacionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evaluación actualizada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluacion"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PeticionInvalida"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrada"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          }
        }
      },
      "delete": {
        "tags": [
          "Evaluaciones"
        ],
        "summary": "Elimina una evaluación en estado Borrador. No lleva cuerpo.",
        "operationId": "EliminarEvaluacion",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstitucionId"
          },
          {
            "$ref": "#/components/parameters/EvaluacionId"
          }
        ],
        "responses": {
          "204": {
            "description": "Evaluación eliminada."
          },
          "400": {
            "$ref": "#/components/responses/PeticionInvalida"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrada"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          }
        }
      }
    },
    "/api/v1/evaluaciones/{id}/publicar": {
      "post": {
        "tags": [
          "Evaluaciones"
        ],
        "summary": "Publica una evaluación en Borrador y le asocia una cohorte.",
        "description": "Control optimista: el cliente envía la versión que vio. Si no coincide con la versión actual, responde 409. Reglas en orden: cohorte obligatoria (400), evaluación inexistente (404), versión distinta (409), estado distinto de Borrador (409), sin preguntas (400), cohorte inexistente o de otra institución (400). Si todo es válido, la evaluación pasa a Publicada y su versión sube en 1.",
        "operationId": "PublicarEvaluacion",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstitucionId"
          },
          {
            "$ref": "#/components/parameters/EvaluacionId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicarEvaluacionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evaluación publicada, con la nueva versión.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluacion"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PeticionInvalida"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrada"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          }
        }
      }
    },
    "/interno/entregas/{entregaId}/calificacion-sugerida": {
      "post": {
        "tags": [
          "Interno"
        ],
        "summary": "Registra la nota sugerida por la IA para una pregunta abierta de una entrega.",
        "description": "Consumidor: IA (herramienta MCP RegistrarCalificacionSugerida, S2-IA-01). Proveedor: Evaluaciones (S2-EV-02). Es el camino oficial por el que la nota sugerida llega a Evaluaciones; la respuesta directa de POST /api/v1/correcciones solo se usa para detectar fallos. La nota se guarda siempre como SUGERIDA, nunca como nota final (RN-CMP-03). Idempotente por (entregaId, preguntaId): si ya hay nota para esa pregunta, responde 200 con yaExistia=true y no la modifica. Reglas en orden: datos inválidos o justificación vacía (400), entrega o pregunta inexistente (404), la pregunta no es Abierta (400), nota mayor al puntajeMaximo de la pregunta (400), nota final ya aprobada por el docente (409). Endpoint interno: no se publica en el gateway (S2-ID-01). Autenticación: header X-Api-Key-Interna (ApiKeyInterna). En estos endpoints internos se acepta el institucionId del cuerpo porque quien llama es un servicio de confianza; igual se verifica que la evaluación pertenezca a esa institución.",
        "operationId": "RegistrarCalificacionSugerida",
        "parameters": [
          {
            "$ref": "#/components/parameters/EntregaId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalificacionSugeridaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nota sugerida registrada, o ya existente (yaExistia=true).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalificacionSugeridaRegistrada"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos: justificación vacía, nota negativa o mayor al puntaje máximo, o la pregunta no es Abierta.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "La nota sugerida (5) supera el puntaje máximo de la pregunta (4).",
                  "status": 400,
                  "errores": []
                }
              }
            }
          },
          "404": {
            "description": "La entrega o la pregunta no existen.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No existe la entrega o la pregunta indicada.",
                  "status": 404,
                  "errores": []
                }
              }
            }
          },
          "409": {
            "description": "El docente ya aprobó la nota final de esa pregunta: la sugerencia ya no se puede registrar.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "La nota final de esta pregunta ya fue aprobada por el docente.",
                  "status": 409,
                  "errores": []
                }
              }
            }
          },
          "401": {
            "description": "Falta el header X-Api-Key-Interna o la clave es incorrecta.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Credencial interna inválida.",
                  "status": 401,
                  "errores": []
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyInterna": []
          }
        ]
      }
    },
    "/interno/salas/{salaId}/entregas": {
      "post": {
        "tags": [
          "Interno"
        ],
        "summary": "Recibe el lote de entregas de una sala finalizada.",
        "description": "Consumidor: Sala en vivo (S2-SA-03, #140). Proveedor: Evaluaciones (S2-EV-01, #143). Idempotente: como máximo una entrega por (salaId, alumnoId); un reintento devuelve 200 con lo ya guardado. Corrige automáticamente el multiple choice. Sala reintenta solo ante error de red o 5xx. Endpoint interno: no se publica en el gateway. Autenticación: header X-Api-Key-Interna (ApiKeyInterna). En estos endpoints internos se acepta el institucionId del cuerpo porque quien llama es un servicio de confianza; igual se verifica que la evaluación pertenezca a esa institución. Corrección del multiple choice (decisión del PO, 09/11/2026): cada pregunta OpcionMultiple suma su puntajeMaximo si la opción elegida tiene esCorrecta=true; incorrecta, sin respuesta u opción inexistente suman 0 (no resta); si hay varias respuestas a la misma pregunta vale la de mayor secuencia; notaMultipleChoice es la suma sin normalizar. Estado: PendienteCorreccion si la entrega tiene al menos una respuesta a una pregunta Abierta; si no, Corregida. El worker de S2-EV-02 toma las entregas en PendienteCorreccion consultando la base (sin colas).",
        "operationId": "RecibirLoteEntregas",
        "x-estado": "planificado",
        "parameters": [
          {
            "$ref": "#/components/parameters/SalaId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoteEntregasRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lote procesado (o ya recibido).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoteEntregasResultado"
                }
              }
            }
          },
          "400": {
            "description": "No cumple lote-entregas-v1 o salaId no coincide con la ruta.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "El salaId del cuerpo no coincide con la ruta.",
                  "status": 400,
                  "errores": []
                }
              }
            }
          },
          "404": {
            "description": "La evaluación no existe, no está publicada o es de otra institución.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No existe una evaluación publicada con ese id.",
                  "status": 404,
                  "errores": []
                }
              }
            }
          },
          "401": {
            "description": "Falta el header X-Api-Key-Interna o la clave es incorrecta.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Credencial interna inválida.",
                  "status": 401,
                  "errores": []
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyInterna": []
          }
        ]
      }
    },
    "/api/v1/evaluaciones/{id}/entregas": {
      "get": {
        "tags": [
          "Resultados"
        ],
        "summary": "Lista las entregas de una evaluación, una por alumno.",
        "description": "Consumidor: Frontend, pantalla de resultados (S2-FE-05, #148). Proveedor: S2-EV-03 (#147). Solo lectura: aprobar la nota es S3-EV-01. Solo Docente o Administrador de la institución del token; Alumno → 403 (RN-CMP-01). Otra institución → 404.",
        "operationId": "ListarEntregas",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/EvaluacionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Entregas (vacío si todavía no se tomó).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EntregaResumen"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No autenticado.",
                  "status": 401,
                  "errores": []
                }
              }
            }
          },
          "403": {
            "description": "El rol no puede ver resultados.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Solo docentes y administradores pueden ver los resultados.",
                  "status": 403,
                  "errores": []
                }
              }
            }
          },
          "404": {
            "description": "Evaluación inexistente o de otra institución.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Evaluación no encontrada.",
                  "status": 404,
                  "errores": []
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/evaluaciones/{id}/entregas/{entregaId}": {
      "get": {
        "tags": [
          "Resultados"
        ],
        "summary": "Detalle de una entrega: cada respuesta, la justificación de la IA y las alertas de foco.",
        "description": "Consumidor: Frontend (S2-FE-05, #148). Proveedor: S2-EV-03 (#147). Solo Docente o Administrador de la institución del token; Alumno → 403 (RN-CMP-01). Otra institución → 404.",
        "operationId": "ObtenerEntrega",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/EvaluacionId"
          },
          {
            "$ref": "#/components/parameters/EntregaIdConsulta"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la entrega.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntregaDetalle"
                }
              }
            }
          },
          "401": {
            "description": "Sin token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "No autenticado.",
                  "status": 401,
                  "errores": []
                }
              }
            }
          },
          "403": {
            "description": "El rol no puede ver resultados.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Solo docentes y administradores pueden ver los resultados.",
                  "status": 403,
                  "errores": []
                }
              }
            }
          },
          "404": {
            "description": "Evaluación o entrega inexistente, o de otra institución.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Entrega no encontrada.",
                  "status": 404,
                  "errores": []
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "InstitucionId": {
        "name": "X-Institucion-Id",
        "in": "header",
        "required": true,
        "description": "Identificador de la institución (tenant). Temporal hasta que la institución se lea del JWT. Si falta o es un UUID vacío, el servicio responde 400.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "EvaluacionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identificador de la evaluación.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "EntregaId": {
        "name": "entregaId",
        "in": "path",
        "required": true,
        "description": "Identificador de la entrega del alumno (EntregaExamen.Id), el mismo que Evaluaciones le envió a IA al pedir la corrección.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SalaId": {
        "name": "salaId",
        "in": "path",
        "required": true,
        "description": "Sala en vivo que finalizó.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "EntregaIdConsulta": {
        "name": "entregaId",
        "in": "path",
        "required": true,
        "description": "Identificador de la entrega.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "PeticionInvalida": {
        "description": "Falta el header de institución o los datos no cumplen las reglas.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            },
            "examples": {
              "faltaInstitucion": {
                "summary": "Falta el header X-Institucion-Id",
                "value": {
                  "title": "Falta el encabezado X-Institucion-Id con un identificador valido.",
                  "status": 400,
                  "errores": []
                }
              }
            }
          },
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            },
            "examples": {
              "faltaInstitucion": {
                "summary": "Falta el header X-Institucion-Id",
                "value": {
                  "title": "Falta el encabezado X-Institucion-Id con un identificador valido.",
                  "status": 400,
                  "errores": []
                }
              }
            }
          }
        }
      },
      "NoEncontrada": {
        "description": "La evaluación no existe en esa institución.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          },
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Conflicto": {
        "description": "La operación no se puede realizar en el estado o la versión actual.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            },
            "examples": {
              "eliminarPublicada": {
                "summary": "DELETE sobre una evaluación que no está en Borrador",
                "value": {
                  "title": "La operacion no se puede realizar en el estado actual.",
                  "status": 409,
                  "detail": "Solo se pueden borrar evaluaciones en estado Borrador.",
                  "errores": [
                    "Solo se pueden borrar evaluaciones en estado Borrador."
                  ]
                }
              }
            }
          },
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            },
            "examples": {
              "eliminarPublicada": {
                "summary": "DELETE sobre una evaluación que no está en Borrador",
                "value": {
                  "title": "La operacion no se puede realizar en el estado actual.",
                  "status": 409,
                  "detail": "Solo se pueden borrar evaluaciones en estado Borrador.",
                  "errores": [
                    "Solo se pueden borrar evaluaciones en estado Borrador."
                  ]
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "EvaluacionRequest": {
        "type": "object",
        "required": [
          "titulo",
          "tipo",
          "preguntasJson"
        ],
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Título de la evaluación."
          },
          "tipo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Tipo de evaluación (por ejemplo Examen o Cuestionario). Más adelante se restringe a Examen, Cuestionario o Quiz."
          },
          "preguntasJson": {
            "$ref": "#/components/schemas/PreguntasJson"
          }
        },
        "example": {
          "titulo": "Examen parcial de Programación I",
          "tipo": "Examen",
          "preguntasJson": {
            "version": 1,
            "preguntas": [
              {
