          "salaId": "6a2b7c3d-8e9f-4a01-b2c3-d4e5f6a7b8c9",
          "estado": "Corregida",
          "respondioAlgo": true,
          "notaMultipleChoice": 1,
          "puntajeMaximoMultipleChoice": 1,
          "notaSugeridaAbiertas": 3.5,
