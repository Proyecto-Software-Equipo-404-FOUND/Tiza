{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identidad-route": {
        "ClusterId": "identidad-cluster",
        "Match": {
          "Path": "/api/v1/identidad/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "cursos-route": {
        "ClusterId": "cursos-cluster",
        "Match": {
          "Path": "/api/v1/cursos/{**catch-all}"
        }
      },
      "cohortes-route": {
        "ClusterId": "cursos-cluster",
        "Match": {
          "Path": "/api/v1/cohortes/{**catch-all}"
        }
      },
      "evaluaciones-route": {
        "ClusterId": "evaluaciones-cluster",
        "Match": {
          "Path": "/api/v1/evaluaciones/{**catch-all}"
        }
      },
      "sala-route": {
        "ClusterId": "sala-cluster",
        "Match": {
          "Path": "/api/v1/salas/{**catch-all}"
        }
      },
      "sala-hub-route": {
        "ClusterId": "sala-cluster",
        "Match": {
          "Path": "/hubs/sala/{**catch-all}"
        }
      },
      "correcciones-route": {
        "ClusterId": "ia-cluster",
        "Match": {
          "Path": "/api/v1/correcciones/{**catch-all}"
        }
      },
      "ia-route": {
        "ClusterId": "ia-cluster",
        "Match": {
          "Path": "/api/v1/ia/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identidad-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5101" }
        }
      },
      "cursos-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5102" }
        }
      },
      "evaluaciones-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5103" }
        }
      },
      "sala-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5104" }
        }
      },
      "ia-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5105" }
        }
      }
    }
  }
}
